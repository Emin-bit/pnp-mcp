<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal PnP Provisioning Template you can apply with `pnp_template_apply`.
  Creates one custom list "TeamRoadmap" with a few columns + a default view.

  Apply via Claude:
    > Apply the template at <absolute path to this file> to the connected site.

  pnp_template_apply will default to background:true because template apply
  is a long-running operation. Track via job_status / job_wait.

  Schema reference: https://docs.microsoft.com/sharepoint/dev/declarative-customization/site-provisioning
-->
<pnp:Provisioning xmlns:pnp="http://schemas.dev.office.com/PnP/2022/09/ProvisioningSchema">
  <pnp:Preferences Generator="@emin-bit/pnp-mcp examples"/>

  <pnp:Templates ID="CONTAINER-TEAMROADMAP">
    <pnp:ProvisioningTemplate ID="TEMPLATE-TEAMROADMAP" Version="1" BaseSiteTemplate="GROUP#0">

      <pnp:Lists>
        <pnp:ListInstance
          Title="TeamRoadmap"
          Description="Lightweight team roadmap created from the @emin-bit/pnp-mcp sample template."
          DocumentTemplate=""
          OnQuickLaunch="true"
          TemplateType="100"
          Url="Lists/TeamRoadmap"
          EnableVersioning="true"
          MinorVersionLimit="0"
          MaxVersionLimit="50"
          DraftVersionVisibility="0">

          <pnp:Fields>
            <Field Type="DateTime"
                   DisplayName="Target Date"
                   Required="FALSE"
                   ID="{4d7a3e3e-1111-4a1a-9d00-000000000001}"
                   StaticName="TargetDate"
                   Name="TargetDate"
                   Format="DateOnly"/>
            <Field Type="Choice"
                   DisplayName="Stage"
                   Required="TRUE"
                   ID="{4d7a3e3e-1111-4a1a-9d00-000000000002}"
                   StaticName="Stage"
                   Name="Stage"
                   Format="Dropdown">
              <Default>Not started</Default>
              <CHOICES>
                <CHOICE>Not started</CHOICE>
                <CHOICE>In progress</CHOICE>
                <CHOICE>Blocked</CHOICE>
                <CHOICE>Done</CHOICE>
              </CHOICES>
            </Field>
            <Field Type="User"
                   DisplayName="Driver"
                   Required="FALSE"
                   ID="{4d7a3e3e-1111-4a1a-9d00-000000000003}"
                   StaticName="Driver"
                   Name="Driver"
                   List="UserInfo"
                   ShowField="ImnName"/>
          </pnp:Fields>

          <pnp:Views>
            <View DisplayName="All Items"
                  Type="HTML"
                  WebPartZoneID="Main"
                  DefaultView="TRUE"
                  MobileView="TRUE"
                  MobileDefaultView="TRUE"
                  Hidden="FALSE"
                  RowLimit="50">
              <ViewFields>
                <FieldRef Name="LinkTitle"/>
                <FieldRef Name="Stage"/>
                <FieldRef Name="Driver"/>
                <FieldRef Name="TargetDate"/>
              </ViewFields>
              <Query>
                <OrderBy>
                  <FieldRef Name="TargetDate" Ascending="TRUE"/>
                </OrderBy>
              </Query>
            </View>
          </pnp:Views>

        </pnp:ListInstance>
      </pnp:Lists>

    </pnp:ProvisioningTemplate>
  </pnp:Templates>

</pnp:Provisioning>
